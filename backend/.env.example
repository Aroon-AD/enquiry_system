# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8080

# Database
MONGO_URI=mongodb://mongo:27017/enquiry_system

# Auth
JWT_SECRET=replace_this_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Seed admin (used once by npm run seed:admin)
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe_StrongPassword123!

# Uploads
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=uploads

# Rate limiting
PUBLIC_RATE_LIMIT_WINDOW_MIN=15
PUBLIC_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MIN=15
API_RATE_LIMIT_MAX=300
